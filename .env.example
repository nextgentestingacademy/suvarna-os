# ==============================================================================
# SUVARNA SAAS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your values.
# NEVER COMMIT .env OR ANY SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Runtime
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Managed PostgreSQL (Neon)
# 1. Sign up at https://neon.tech and create a project in Mumbai (ap-south-1).
# 2. Toggle "Connection Pooling" ON in the Neon dashboard.
# 3. DATABASE_URL: Use the pooled connection string (port 6543 / -pooler domain).
# 4. DIRECT_URL: Use the unpooled direct connection string (port 5432).
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-south-1.aws.neon.tech/suvarna_dev?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-sample.ap-south-1.aws.neon.tech/suvarna_dev?sslmode=require"

# Better Auth Configuration
# Generate a cryptographically random 32-byte secret using: openssl rand -base64 32
BETTER_AUTH_SECRET="development-secret-change-in-production-min-32-chars-long"
BETTER_AUTH_URL="http://localhost:3000"

# Application Business Defaults (Indian Jewellery Retail)
# Note: Tax rates are configurable per tenant and subject to statutory validation.
DEFAULT_GST_RATE="3.0"
